{
  "name": "paperdesk",
  "version": "0.1.0",
  "description": "PaperDesk — 论文阅读、翻译、批注与研究工作台",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:unit": "node scripts/test-unit.ts",
    "test:coords": "node scripts/test-coords.ts",
    "test:py": "python python/tests/test_model_protocol.py && python python/tests/test_import.py && python python/tests/test_http.py && python python/tests/test_extract.py && python python/tests/test_structure.py && python python/tests/test_modules.py && python python/tests/test_formula_samples.py && python python/tests/test_eval_metrics.py && python python/tests/test_skills.py && python python/tests/test_vision.py && python python/tests/test_cjk_font.py && python python/tests/test_translate.py && python python/tests/test_export.py && python python/tests/test_inline_math.py && python python/tests/test_inline_math_render.py",
    "test:net": "node scripts/net-check.cjs",
    "test:e2e": "node scripts/e2e.cjs",
    "test:workspace": "npm run build && node scripts/test-workspace-ui.cjs",
    "shots": "node scripts/shot.cjs",
    "smoke": "node scripts/smoke-run.cjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:coords && npm run test:py && npm run smoke",
    "ci": "npm test",
    "sample": "python scripts/make-sample.py",
    "corpus": "python scripts/make-corpus.py",
    "eval": "python scripts/make-corpus.py && python scripts/eval-corpus.py",
    "preflight": "node scripts/preflight.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:personal": "npm run build && electron-builder --win --x64 --dir && python scripts/package-personal.py",
    "test:settings": "npm run build && node scripts/test-settings-ui.cjs"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.paperdesk.desktop",
    "productName": "PaperDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "app/**/*",
          "requirements.txt",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "PaperDesk-${version}-${arch}-Setup.${ext}"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cytoscape": "^3.34.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7"
  }
}
